{
  "name": "deadline-daemon",
  "version": "1.0.0",
  "description": "Autonomous deadline-driven engineering architecture combining the Deadline Method with the Codebase Omni-Scanner.",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "cd packages/scanner && node --experimental-strip-types --loader ./scripts/ts-loader.mjs scripts/verify_codebase_scanner.ts",
    "test:scanner": "cd packages/scanner && node --experimental-strip-types --loader ./scripts/ts-loader.mjs scripts/verify_codebase_scanner.ts",
    "install:skills": "powershell -ExecutionPolicy Bypass -File ./scripts/install.ps1",
    "verify": "powershell -ExecutionPolicy Bypass -File ./scripts/verify.ps1"
  },
  "keywords": [
    "deadline",
    "autonomous-agent",
    "mcp",
    "ast-scanner",
    "pagerank",
    "repomap",
    "wave-planner",
    "runtime-qa",
    "codebase-scanner",
    "engineering"
  ],
  "author": "Deadline Daemon Engineering Team",
  "license": "MIT"
}
